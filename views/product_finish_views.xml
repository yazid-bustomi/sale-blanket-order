<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_finish_list" model="ir.ui.view">
        <field name="name">product.finish.list</field>
        <field name="model">product.finish</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="display_name"/>
            </list>
        </field>
    </record>

    <record id="view_product_finish_form" model="ir.ui.view">
        <field name="name">product.finish.form</field>
        <field name="model">product.finish</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_finish" model="ir.actions.act_window">
        <field name="name">Finish Product</field>
        <field name="res_model">product.finish</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_finish_list"/>
    </record>

    <menuitem id="menu_product_finish" name="Finish Product" parent="sale.product_menu_catalog" action="action_product_finish"/>
</odoo>
